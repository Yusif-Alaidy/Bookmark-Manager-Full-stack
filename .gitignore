## ===== .NET / ASP.NET Core (backend/) =====
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/*.suo
backend/**/appsettings.Development.json

# SQLite database file (generated locally/on deploy, don't commit)
backend/**/*.db
backend/**/*.db-shm
backend/**/*.db-wal

# EF Core migrations are fine to commit — do NOT ignore backend/**/Migrations/

## ===== Angular / Node (frontend/) =====
frontend/**/node_modules/
frontend/**/dist/
frontend/**/.angular/
frontend/**/*.log
frontend/**/npm-debug.log*

## ===== Editors / OS =====
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

## ===== Environment secrets (never commit) =====
**/appsettings.*.json
!backend/**/appsettings.json
**/.env